# =================================================================
# EWUmate Mobile — Environment Configuration Template
# =================================================================
# Duplicate this file as '.env' and fill in the values below.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO VERSION CONTROL.

# Supabase Cloud Project Configuration
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend Microservices (Azure Functions / Scrapers)
AZURE_FUNCTION_URL=https://your-functions-host.azurewebsites.net

# Google OAuth Client Credentials
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com

# Upstash Redis Cache (Optional / Dev Mock)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
