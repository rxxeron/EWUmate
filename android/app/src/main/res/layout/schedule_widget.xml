<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's Schedule"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Wednesday, Apr 29"
                android:textColor="#8A99AD"
                android:textSize="11sp" />
        </RelativeLayout>

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/empty_state_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/empty_state_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Chill Mode\nNo classes scheduled."
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Schedule List View -->
        <LinearLayout
            android:id="@+id/schedule_list_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Slot 1 -->
            <LinearLayout
                android:id="@+id/slot_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="4dp"
                android:background="@drawable/slot_bg"
                android:paddingVertical="6dp"
                android:paddingHorizontal="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/slot_1_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHE109"
                    android:textColor="#22D3EE"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  •  "
                    android:textColor="#475569"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/slot_1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="08:30 AM"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/slot_1_room"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AB2-601"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:gravity="end"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Slot 2 -->
            <LinearLayout
                android:id="@+id/slot_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="4dp"
                android:background="@drawable/slot_bg"
                android:paddingVertical="6dp"
                android:paddingHorizontal="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/slot_2_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ICE204"
                    android:textColor="#22D3EE"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  •  "
                    android:textColor="#475569"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/slot_2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:10 AM"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/slot_2_room"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AB2-702"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:gravity="end"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Slot 3 -->
            <LinearLayout
                android:id="@+id/slot_3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="4dp"
                android:background="@drawable/slot_bg"
                android:paddingVertical="6dp"
                android:paddingHorizontal="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/slot_3_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAT102"
                    android:textColor="#22D3EE"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  •  "
                    android:textColor="#475569"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/slot_3_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11:50 AM"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/slot_3_room"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AB1-902"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:gravity="end"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Slot 4 -->
            <LinearLayout
                android:id="@+id/slot_4"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/slot_bg"
                android:paddingVertical="6dp"
                android:paddingHorizontal="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/slot_4_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ICE107"
                    android:textColor="#22D3EE"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  •  "
                    android:textColor="#475569"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/slot_4_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01:30 PM"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/slot_4_room"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AB2-502"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:gravity="end"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
